{
  "name": "langningchen",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.20.0",
  "license": "AGPL-3.0-only",
  "publisher": "langningchen",
  "repository": {
    "type": "git",
    "url": "https://github.com/langningchen/langningchen"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm refresh:data && pnpm crop:game-assets",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "cache:game-icons": "tsx scripts/cache-game-stat-icons.ts",
    "crop:game-assets": "tsx scripts/crop-game-assets.ts",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deploy": "pnpm build:worker && opennextjs-cloudflare deploy -- --keep-vars",
    "lint": "eslint .",
    "profile:stats": "node scripts/update-profile-stats.mjs",
    "preview": "pnpm build:worker && opennextjs-cloudflare preview",
    "refresh:data": "tsx scripts/refresh-runtime-fallback.ts",
    "upload": "pnpm build:worker && opennextjs-cloudflare upload -- --keep-vars"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/material-nextjs": "^9.1.1",
    "@primer/octicons-react": "^19.32.0",
    "lenis": "^1.3.25",
    "motion": "^12.43.0",
    "next": "^16.3.0",
    "next-intl": "^4.13.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "simple-icons": "^16.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "sharp": "0.35.3",
    "tsx": "^4.23.5",
    "typescript": "~6.0.3",
    "wrangler": "^4.118.0"
  }
}
